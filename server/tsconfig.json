{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "outDir": "../dist-api",
    "rootDir": ".."
  },
  "include": ["src/**/*.ts", "../src/data/northStar.ts", "../src/data/agentRuntime.ts", "../src/data/workspaceHostnames.ts"],
  "exclude": ["src/**/*.test.ts"]
}
