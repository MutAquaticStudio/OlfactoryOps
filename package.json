{
  "name": "olfactoryops",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:test": "tsc -b && vite build --mode test && node scripts/release-manifest.mjs page-artifact dist",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "build": "tsc -b && vite build && node scripts/release-manifest.mjs page-artifact dist",
    "build:api": "tsc -p server/tsconfig.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "build:tenant-router": "wrangler deploy --dry-run --config wrangler.tenant-router.toml --outdir dist-tenant-router",
    "start:api": "node dist-api/server/src/main.js",
    "dev:worker": "wrangler dev --local --port 8787",
    "deploy:worker": "wrangler deploy",
    "deploy:tenant-router": "wrangler deploy --config wrangler.tenant-router.toml",
    "deploy:pages": "npm run build && wrangler --cwd cloudflare/pages pages deploy --branch main",
    "deploy:pages:test": "npm run build:test && wrangler --cwd cloudflare/pages pages deploy --branch test",
    "d1:migrate:local": "wrangler d1 migrations apply olfactoryops-production --local",
    "d1:migrate:remote": "wrangler d1 migrations apply olfactoryops-production --remote",
    "lint": "oxlint --ignore-pattern dist-tenant-router/**",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:v2": "tsc -p tsconfig.v2.json",
    "test:ux": "npm run build && playwright test --config playwright.ux.config.ts",
    "test:ux:update": "npm run build && playwright test --config playwright.ux.config.ts --update-snapshots",
    "test:v2:role-e2e": "node scripts/run-v2-role-e2e.mjs",
    "test:formula:live": "node scripts/test-formula-live.mjs",
    "test:functional:report": "node scripts/run-functional-report.mjs",
    "test:signup:tenant": "node scripts/test-signup-tenant.mjs",
    "test:qa:fixtures": "vitest run scripts/qa-isolated-fixture-support.test.mjs",
    "test:qa:role-fixtures": "node scripts/create-isolated-role-fixtures.mjs",
    "test:qa:production-smoke": "node scripts/run-production-smoke.mjs",
    "test:role-e2e:strict": "cross-env QA_REQUIRE_ROLE_E2E=true playwright test --config playwright.ux.config.ts e2e/role-workflows.playwright.ts",
    "release:identity:check": "node scripts/release-identity-check.mjs",
    "release:manifest:generate": "node scripts/release-manifest.mjs generate",
    "release:manifest:validate": "node scripts/release-manifest.mjs validate",
    "release:provenance:verify": "node scripts/release-manifest.mjs provenance",
    "release:migrations:verify": "node scripts/verify-migrations.mjs",
    "release:docs:check": "node scripts/validate-release-docs.mjs",
    "release:bundle:report": "node scripts/analyze-bundle.mjs",
    "release:status:benchmark": "node scripts/benchmark-status.mjs",
    "release:nonsecret-gate": "npm run release:identity:check && npm run release:migrations:verify && npm run release:docs:check && npm run release:manifest:generate && npm run release:manifest:validate",
    "v2:postgres:verify": "cross-env V2_QA_ENVIRONMENT=test node scripts/verify-v2-postgres.mjs",
    "v2:postgres:rls": "cross-env V2_QA_ENVIRONMENT=test tsx scripts/verify-v2-rls.ts",
    "test:model-runtime": "docker build --pull=false --tag olfactoryops-model-runtime-phase4 services/scientific/model-runtime && docker run --rm olfactoryops-model-runtime-phase4",
    "security:client-bundle": "node scripts/check-client-bundle-secrets.mjs",
    "security:hash-admin-password": "node scripts/generate-admin-password-hash.mjs",
    "deploy:check": "npm run build && npm run build:api && npm run typecheck:worker && npm run build:worker && npm run build:tenant-router && npm run test && npm run security:client-bundle",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.6",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "fast-uri": "3.1.5"
  }
}
