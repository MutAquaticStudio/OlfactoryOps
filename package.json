{
  "name": "olfactoryops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:test": "tsc -b && vite build --mode test",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "start:api": "node dist-api/server/src/main.js",
    "dev:worker": "wrangler dev --local --port 8787",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler --cwd cloudflare/pages pages deploy --branch main",
    "deploy:pages:test": "npm run build:test && wrangler --cwd cloudflare/pages pages deploy --branch test",
    "d1:migrate:local": "wrangler d1 migrations apply olfactoryops-production --local",
    "d1:migrate:remote": "wrangler d1 migrations apply olfactoryops-production --remote",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:formula:live": "node scripts/test-formula-live.mjs",
    "test:functional:report": "node scripts/run-functional-report.mjs",
    "test:signup:tenant": "node scripts/test-signup-tenant.mjs",
    "security:client-bundle": "node scripts/check-client-bundle-secrets.mjs",
    "security:hash-admin-password": "node scripts/generate-admin-password-hash.mjs",
    "deploy:check": "npm run build && npm run build:api && npm run typecheck:worker && npm run build:worker && npm run test && npm run security:client-bundle",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "pg": "8.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^24.13.2",
    "@types/pg": "8.11.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "nanoid": "3.3.18"
  }
}
