# Frontend
# Local Nest API: http://127.0.0.1:4000/api/v1
# Local Cloudflare Worker API: http://127.0.0.1:8787/api/v1
# Production Worker API: https://api.labofscents.org/api/v1
VITE_API_BASE_URL="http://127.0.0.1:4000/api/v1"

# API
PORT=4000
HOST="0.0.0.0"
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,https://labofscents.org,https://www.labofscents.org,https://app.labofscents.org"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Worker-only integration secrets. Set with `wrangler secret put`, never in VITE_ variables.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ARTISAN="price_..."
# STRIPE_PRICE_ATELIER="price_..."
# STRIPE_PRICE_MAISON="price_..."
# BILLING_RETURN_URL="https://test.labofscents.pages.dev"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="OlfactoryOps <notifications@example.com>"
# SENTRY_DSN="https://public-key@o0.ingest.sentry.io/project-id"
# CLOUDFLARE_API_TOKEN="..."
